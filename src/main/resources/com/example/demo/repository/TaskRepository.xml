<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.repository.TaskRepository">

    <resultMap id="TaskSummaryResultMap" type="com.example.demo.entity.TaskSummary">
        <id property="taskId" column="task_id"/>
        <result property="taskName" column="task_name"/>
        <result property="limitDate" column="limit_date"/>
        <result property="memoCount" column="memo_count"/>

        <association property="status" javaType="com.example.demo.entity.Status">
            <id property="statusCode" column="status_code"/>
            <result property="statusName" column="status_name"/>
        </association>
    </resultMap>

    <select id="findAll" resultMap="TaskSummaryResultMap"> 
        SELECT 
            tt.task_id, task_name, limit_date, ms.status_code, ms.status_name,COUNT(tm.memo_id) as memo_count
        FROM t_task tt 
            INNER JOIN m_status ms 
                ON tt.status_code = ms.status_code
            LEFT OUTER JOIN t_memo tm 
                ON tt.task_id = tm.task_id
        GROUP BY tt.task_id, task_name, limit_date, ms.status_code, ms.status_name
        ORDER BY tt.task_id 
    </select>
</mapper>